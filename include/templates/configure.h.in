///
/// \file
/// This file contains useful macro defines, like version number, project name,
/// paths, etc. cmake parses this file and creates configure.h, the latter which
/// can then be included e.g. in C++, such that the defines become available.
///
//===----------------------------------------------------------------------===//
#ifndef CONFIGURE_H_
#define CONFIGURE_H_

#include <string>

namespace scg {
namespace configure {
// Version number
const std::string version = "${CMAKE_PROJECT_VERSION}";

// Project name
const std::string projectName = "${CMAKE_PROJECT_NAME}";

// Paths
const std::string rootPath = "${CMAKE_SOURCE_DIR}";
const std::string dataPath = "${CMAKE_SOURCE_DIR}/data";
const std::string sourcePath = "${CMAKE_SOURCE_DIR}/src";
const std::string buildPath = "${CMAKE_SOURCE_DIR}/build";
const std::string includePath = "${CMAKE_SOURCE_DIR}/include";

// License statement
const std::string licenseStatement =
    "Copyright (C) 2019 suprcongpu developers, Inc.\nThis is free software; "
    "see the source for copying conditions.\nThere is NO warranty; not even "
    "for MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.";

} // namespace configure
} // namespace scg

#endif // CONFIGURE_H_
